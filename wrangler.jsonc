// SIS Bids as a Cloudflare Worker with static assets (Workers Builds runs `npx wrangler deploy` on every push to main).
{
  "name": "sis-bids",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",
  // the page files; the Worker runs first on every request so sign-in covers them too
  "assets": { "directory": "site", "binding": "ASSETS", "run_worker_first": true },
  // SIS Tools' own D1 database, shared (the ID is what binds it; the name is only a label for wrangler commands)
  "d1_databases": [
    { "binding": "DB", "database_name": "sis-tools-db", "database_id": "98981534-1296-4b3a-866b-2cbec51f5089" }
  ],
  // sign-in: ACCESS_AUD is the Cloudflare Access app's Application Audience tag for this site. ACCESS_TEAM is optional:
  // when set it must be the team domain (like yourteam.cloudflareaccess.com), not a name. Not secrets; the repo is private.
  "vars": {
    "ACCESS_AUD": "1c11090a4a1b2c3d8890a383707a86669f49a70b24086cfac0b7f8f60d62bbe3",
    "ADMIN_EMAILS": "tonyf@ihs-sierra.com"
  },
  // keep_vars: anything else added in the dashboard (like SIS_TOOLS_HOST) survives a deploy
  "keep_vars": true,
  "observability": { "enabled": true }
}
