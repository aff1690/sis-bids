// SIS Bids as a Cloudflare Worker with static assets (Workers Builds runs `npx wrangler deploy` on every push to main).
{
  "name": "sis-bids",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",
  // the page files; the Worker runs first on every request so sign-in covers them too
  "assets": { "directory": "site", "binding": "ASSETS", "run_worker_first": true },
  // SIS Tools' own D1 database, shared (the ID is what binds it; the name is only a label for wrangler commands)
  "d1_databases": [
    { "binding": "DB", "database_name": "sis-tools-db", "database_id": "98981534-1296-4b3a-866b-2cbec51f5089" }
  ],
  // ACCESS_AUD, ACCESS_TEAM, ADMIN_EMAILS and SIS_TOOLS_HOST are set in the dashboard (Settings > Variables and secrets);
  // keep_vars stops a deploy from wiping them
  "keep_vars": true,
  "observability": { "enabled": true }
}
